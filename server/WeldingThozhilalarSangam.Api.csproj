<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.Statistics.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.32" />
    <PackageReference Include="MongoDB.Driver" Version="2.29.0" />
    <!-- Compatible security patch; regression tests exercise wire compression.
         SharpCompress 0.48 removes a type required by this driver; see readiness checklist. -->
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>
</Project>
