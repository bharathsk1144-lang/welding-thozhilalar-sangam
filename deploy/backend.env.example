# TEMPLATE ONLY. Do not source or deploy with placeholders. Secrets stay backend-only.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080
MongoDb__ConnectionString=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_STAGING_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MongoDb__DatabaseName=WTS_Staging
Admin__Username=REPLACE_OPERATOR_NAME
Admin__Email=
Admin__Password=
Admin__PasswordHash=REPLACE_WITH_IDENTITY_V3_HASH
Admin__JwtKey=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
Admin__Issuer=https://REPLACE_STAGING_API_HOST
Admin__Audience=https://REPLACE_VERCEL_PREVIEW_HOST
Admin__ExpiryHours=8
Cors__AllowedOrigins__0=https://REPLACE_VERCEL_PREVIEW_HOST
Uploads__RootPath=/var/lib/wts/uploads
# Remain false until a provider adapter is reviewed, tested and approved.
SMS_ENABLED=false
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
# November 8 registration setting; forgot-password OTP remains required.
Authentication__OtpEnabled=false
Membership__OrganizationRegistrationNumber=
# Configure/review exclusions through private deployment settings; never copy local IDs to React.
PublicStatistics__ClassificationReviewed=false
# PublicStatistics__TestUserIds__0=EXACT_CONFIRMED_SYNTHETIC_OBJECT_ID
# Only the actual reverse proxy's IP, if a proxy is used:
# ReverseProxy__KnownProxies__0=127.0.0.1
Logging__LogLevel__Default=Warning
